# ============================================================
# PRISM — Environment Configuration (EXAMPLE)
# ============================================================
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Legacy machine-to-machine API key. Browser users should use the login session.
API_KEY=change-me-to-a-long-random-secret-at-least-32-chars
API_KEY_MIN_LENGTH=32

# Human login / RBAC
# Generate with: openssl rand -hex 32
PRISM_JWT_SECRET=replace-with-at-least-32-random-characters
PRISM_SESSION_HOURS=8
# First startup creates the owner/workspace only when these are set.
PRISM_BOOTSTRAP_EMAIL=you@company.com
PRISM_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
PRISM_BOOTSTRAP_TENANT_NAME=My PRISM Workspace

# CORS
CORS_ORIGINS=

# PostgreSQL
POSTGRES_USER=incident
POSTGRES_PASSWORD=replace-this-password
POSTGRES_DB=incident_db
DATABASE_URL=postgresql+asyncpg://incident:replace-this-password@localhost:5433/incident_db
DATABASE_SYNC_URL=postgresql+psycopg2://incident:replace-this-password@localhost:5433/incident_db

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-this-password

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss_index

# Limits / rate limiting
MAX_CONCURRENT_INVESTIGATIONS=3
INVESTIGATION_RATE_LIMIT=10/minute
REDIS_URL=
REQUIRE_TENANT_HEADER=true
MAX_AFFECTED_SERVICES=50
MAX_LOG_LINES=500
MAX_LOG_LINE_CHARS=2000
MAX_TRACES=200
MAX_REQUEST_BODY_BYTES=1048576
MAX_MEMORY_QUERY_LENGTH=2000
MAX_PAGINATION_LIMIT=100
MAX_PREDICTION_BATCH=50
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=60.0
EMBEDDING_DIM=384
CONSENSUS_MIN_VOTERS=2
CONSENSUS_CONFIDENCE_THRESHOLD=0.6
CAUSAL_MAX_DEPTH=10
CAUSAL_MIN_CONFIDENCE=0.1
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.5
AGENT_DEFAULT_RELIABILITY=0.5
AGENT_MIN_RELIABILITY=0.2
AGENT_RELIABILITY_DECAY=0.9
AGENT_TIMEOUT_SECONDS=45.0
ENABLE_NEO4J=true
ENABLE_OLLAMA=true
ENABLE_FAISS=true
LEARNING_MODE=online
LEARNING_REQUIRE_CONFIRMATION=true
