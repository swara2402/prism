# ============================================================
# PRISM — Environment Configuration (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# -------- App --------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# -------- API Authentication (REQUIRED in production) --------
# Generate a strong random key, e.g.: openssl rand -hex 32
# The placeholder below is intentionally rejected by the production config guard.
API_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# -------- CORS (comma-separated origins; leave empty for dev defaults) --------
# Production example: CORS_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=

# -------- PostgreSQL --------
POSTGRES_USER=incident
POSTGRES_PASSWORD=Prism123
POSTGRES_DB=incident_db
# Compose publishes PostgreSQL on host port 5433; the API container overrides
# these URLs with the internal postgres:5432 address.
DATABASE_URL=postgresql+asyncpg://incident:Prism123@localhost:5433/incident_db
DATABASE_SYNC_URL=postgresql+psycopg2://incident:Prism123@localhost:5433/incident_db

# -------- Neo4j --------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Prism123

# -------- Ollama --------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# -------- Embeddings --------
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# -------- FAISS --------
FAISS_INDEX_PATH=./data/faiss_index

# -------- Limits / Rate limiting --------
MAX_CONCURRENT_INVESTIGATIONS=3
INVESTIGATION_RATE_LIMIT=10/minute
# Optional Redis URL for a shared (multi-replica) rate limiter.
# Empty = in-process sliding window (single replica only).
REDIS_URL=
# When true, incident endpoints reject requests without X-Tenant-Id.
# Enable for strict tenant isolation; off preserves backward compatibility.
REQUIRE_TENANT_HEADER=false
MAX_AFFECTED_SERVICES=50
MAX_LOG_LINES=500
MAX_LOG_LINE_CHARS=2000
MAX_TRACES=200
MAX_REQUEST_BODY_BYTES=1048576
MAX_MEMORY_QUERY_LENGTH=2000
MAX_PAGINATION_LIMIT=100
MAX_PREDICTION_BATCH=50
API_KEY_MIN_LENGTH=32

# -------- Database pool (SQLAlchemy) --------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# -------- LLM / embeddings --------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=60.0
EMBEDDING_DIM=384

# -------- Consensus / causal / memory tuning --------
CONSENSUS_MIN_VOTERS=2
CONSENSUS_CONFIDENCE_THRESHOLD=0.6
CAUSAL_MAX_DEPTH=10
CAUSAL_MIN_CONFIDENCE=0.1
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.5

# -------- Agent defaults --------
AGENT_DEFAULT_RELIABILITY=0.5
AGENT_MIN_RELIABILITY=0.2
AGENT_RELIABILITY_DECAY=0.9
AGENT_TIMEOUT_SECONDS=45.0

# -------- Feature flags --------
ENABLE_NEO4J=true
ENABLE_OLLAMA=true
ENABLE_FAISS=true

# -------- Continuous learning / experiment reproducibility --------
# online  = persistent learning (product mode; only confirmed incidents learn)
# frozen  = no learning at all (independent, reproducible evaluation runs)
LEARNING_MODE=online
# Lock learning to incidents whose root cause was confirmed (ground truth).
# PRISM never learns from its own unverified consensus.
LEARNING_REQUIRE_CONFIRMATION=true
